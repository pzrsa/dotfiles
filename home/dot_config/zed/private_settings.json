{
  "theme": {
    "mode": "system",
    "light": "Gruvbox Material Light Hard",
    "dark": "Gruvbox Material Dark Hard",
  },
  "ssh_connections": [
    {
      "host": "franka",
      "args": [],
      "projects": [
        {
          "paths": [
            "/data/workspace/ubu20"
          ]
        },
        {
          "paths": [
            "/data/workspace/umi_ros"
          ]
        }
      ]
    },
    {
      "host": "192.168.144.30",
      "username": "yaak",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/yaak"
          ]
        }
      ]
    },
    {
      "host": "franka",
      "args": [],
      "projects": []
    }
  ],
  "buffer_font_size": 14,
  "ui_font_size": 15,
  "agent_ui_font_size": 18,
  "agent_buffer_font_size": 14,
  "buffer_font_family": "TX-02",
  "ui_font_family": "TX-02",
  "project_panel": {
    "default_width": 300,
    "entry_spacing": "standard",
    "hide_root": true,
  },
  "git_panel": {
    "dock": "left",
    "sort_by_path": false,
    "default_width": 300,
  },
  "outline_panel": {
    "default_width": 300,
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "always",
    "use_smartcase_find": true,
  },
  "collaboration_panel": { "button": false },
  "gutter": { "runnables": false },
  "buffer_font_features": { "calt": false },
  "vertical_scroll_margin": 22,
  "terminal": {
    "toolbar": { "breadcrumbs": false },
    "shell": { "program": "fish" },
    "line_height": "standard",
  },
  "command_aliases": {
    "w": "wall",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "languages": {
    "TypeScript": {
      "language_servers": ["tsgo", "vtsls"],
    },
  },
  "inline_code_actions": false,
  "git": { "inline_blame": { "enabled": true, "show_commit_summary": true } },
  "preview_tabs": { "enabled": false },
  "toolbar": { "code_actions": false, "quick_actions": false },
  "tab_bar": {
    "show_nav_history_buttons": true,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "show_diagnostics": "errors",
    "file_icons": true,
  },
  "title_bar": {
    "show_sign_in": false,
  },
  "minimap": {
    "show": "never",
  },
  "autosave": "on_focus_change",
  "edit_predictions": {
    "provider": "copilot",
    "disabled_globs": [],
  },
  "disable_ai": true,
}
