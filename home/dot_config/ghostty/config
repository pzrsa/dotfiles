theme = light:Gruvbox Material Light, dark:Gruvbox Material Dark
command = "/opt/homebrew/bin/fish"

font-size = 15
font-family = "TX-02"
mouse-hide-while-typing = true
font-feature = -calt
term = "xterm-256color"
macos-option-as-alt = left
background-opacity = 0.90
background-blur-radius = 20
mouse-hide-while-typing = true
adjust-cell-height = 7
macos-titlebar-style = transparent
maximize = true
clipboard-paste-protection=false
macos-non-native-fullscreen = visible-menu



keybind = shift+enter=text:\x1b\r
keybind = ctrl+alt+h=goto_split:left
keybind = ctrl+alt+j=goto_split:down
keybind = ctrl+alt+k=goto_split:up
keybind = ctrl+alt+l=goto_split:right

